{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tiber-strategy/schemas/dynasty_strategy_ontology_v1.schema.json",
  "title": "DYNASTY_STRATEGY_ONTOLOGY_V1",
  "description": "Deterministic dynasty strategy vocabulary contract: concepts, roster states, asset archetype criteria, timeline rules, and slotted explanation templates. Rules only — never player rows, identifiers, rankings, or projections.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "model_version",
    "generated_at",
    "row_count",
    "concepts",
    "player_asset_archetypes",
    "roster_state_definitions",
    "timeline_rules",
    "explanation_templates",
    "consumer_manifest"
  ],
  "properties": {
    "artifact_type": { "type": "string", "const": "DYNASTY_STRATEGY_ONTOLOGY_V1" },
    "schema_version": { "type": "string", "const": "dynasty_strategy_ontology_v1" },
    "model_version": { "type": "string", "pattern": "^dynasty-strategy-ontology-v\\d+\\.\\d+\\.\\d+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "row_count": { "type": "integer", "const": 0 },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "group",
          "description",
          "boundary",
          "use_case",
          "positive_signals",
          "negative_signals",
          "consumer_guidance",
          "related_concepts"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string", "minLength": 1 },
          "group": { "type": "string", "enum": ["timeline_value", "roster_structure"] },
          "description": { "type": "string", "minLength": 1 },
          "boundary": { "type": "string", "minLength": 1 },
          "use_case": { "type": "string", "minLength": 1 },
          "positive_signals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "negative_signals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "consumer_guidance": { "type": "string", "minLength": 1 },
          "related_concepts": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
        }
      }
    },
    "player_asset_archetypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "description",
          "boundary",
          "criteria",
          "required_inputs",
          "missing_input_behavior",
          "positive_signals",
          "negative_signals",
          "consumer_guidance"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "boundary": { "type": "string", "minLength": 1 },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["criterion_id", "input", "comparator", "value", "note"],
              "properties": {
                "criterion_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "input": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "comparator": { "type": "string", "enum": ["in", "not_in", "equals"] },
                "value": { "type": ["string", "array"], "items": { "type": "string", "minLength": 1 } },
                "note": { "type": "string", "minLength": 1 }
              }
            }
          },
          "required_inputs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
          "missing_input_behavior": { "type": "string", "const": "do_not_assign_fail_closed" },
          "positive_signals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "negative_signals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "consumer_guidance": { "type": "string", "minLength": 1 }
        }
      }
    },
    "roster_state_definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "description",
          "boundary",
          "evidence_signals",
          "misread_risks",
          "consumer_guidance",
          "related_templates"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "boundary": { "type": "string", "minLength": 1 },
          "evidence_signals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["signal", "interpretation"],
              "properties": {
                "signal": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "interpretation": { "type": "string", "minLength": 1 }
              }
            }
          },
          "misread_risks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "consumer_guidance": { "type": "string", "minLength": 1 },
          "related_templates": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
        }
      }
    },
    "timeline_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "description",
          "boundary",
          "when",
          "then",
          "required_inputs",
          "consumer_guidance"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^tr_[a-z0-9_]+$" },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "boundary": { "type": "string", "minLength": 1 },
          "when": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["input", "comparator", "value"],
              "properties": {
                "input": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "comparator": { "type": "string", "enum": ["in", "not_in", "equals"] },
                "value": { "type": ["string", "array"], "items": { "type": "string", "minLength": 1 } }
              }
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": ["derive", "excludes_archetypes", "note"],
            "properties": {
              "derive": {
                "type": "object",
                "additionalProperties": false,
                "required": ["input", "value"],
                "properties": {
                  "input": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                  "value": { "type": "string", "minLength": 1 }
                }
              },
              "excludes_archetypes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
              "note": { "type": "string", "minLength": 1 }
            }
          },
          "required_inputs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
          "consumer_guidance": { "type": "string", "minLength": 1 }
        }
      }
    },
    "explanation_templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "description",
          "boundary",
          "applies_to",
          "slots",
          "text",
          "consumer_guidance"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "boundary": { "type": "string", "minLength": 1 },
          "applies_to": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
          "slots": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
          "text": { "type": "string", "minLength": 1 },
          "consumer_guidance": { "type": "string", "minLength": 1 }
        }
      }
    },
    "consumer_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_name",
        "intended_consumers",
        "consumer_safety_rules",
        "required_inputs",
        "non_authority_boundaries",
        "missing_input_behavior",
        "fail_closed_behavior",
        "future_contract_decisions"
      ],
      "properties": {
        "contract_name": { "type": "string", "const": "DYNASTY_STRATEGY_ONTOLOGY_V1_DOWNSTREAM_CONSUMPTION" },
        "intended_consumers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "consumer_safety_rules": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule_id", "statement"],
            "properties": {
              "rule_id": { "type": "string", "pattern": "^cannot_[a-z0-9_]+$" },
              "statement": { "type": "string", "minLength": 1 }
            }
          }
        },
        "required_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input_id", "description", "status", "expected_source"],
            "properties": {
              "input_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "description": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["available", "derived", "future_contract"] },
              "expected_source": { "type": "string", "minLength": 1 }
            }
          }
        },
        "non_authority_boundaries": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
        "missing_input_behavior": { "type": "string", "const": "do_not_assign_fail_closed" },
        "fail_closed_behavior": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "missing_artifact",
            "malformed_artifact",
            "unknown_concept_reference",
            "missing_required_input",
            "unknown_input_status"
          ],
          "properties": {
            "missing_artifact": { "type": "string", "minLength": 1 },
            "malformed_artifact": { "type": "string", "minLength": 1 },
            "unknown_concept_reference": { "type": "string", "minLength": 1 },
            "missing_required_input": { "type": "string", "minLength": 1 },
            "unknown_input_status": { "type": "string", "minLength": 1 }
          }
        },
        "future_contract_decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision_id", "summary", "status"],
            "properties": {
              "decision_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "summary": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["open", "decided"] }
            }
          }
        }
      }
    }
  }
}
